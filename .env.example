# Foccus Car — variáveis de ambiente (copie para apps/web/.env.local em desenvolvimento).
# Nunca coloque valores reais no código nem no git. Em produção use o gerenciador de secrets da hospedagem.
NODE_ENV=development                     # development | staging | production

# Banco (a aplicação usa um papel SEM superusuário, sujeito ao isolamento por empresa)
DATABASE_URL=postgres://foccus_app:SENHA@localhost:5432/foccus
DATABASE_MIGRATION_URL=postgres://foccus_owner:SENHA@localhost:5432/foccus
DATABASE_POOL_MAX=10
# Opcional: URL específica da aplicação (senão, DATABASE_URL). Na Vercel, ver docs/AMBIENTE-DE-TESTES.md.
DATABASE_APP_URL=

# Autenticação (Better Auth)
BETTER_AUTH_SECRET=                      # 32+ caracteres aleatórios: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
DEFAULT_COMPANY_SLUG=foccus-car
DEFAULT_COMPANY_DOMAIN=

# Google (principal) — console.cloud.google.com → Credenciais → OAuth
# Redirect: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft (Outlook/Hotmail/contas corporativas) — portal.azure.com → Registros de aplicativo
# Tipo de conta: "contas pessoais Microsoft e de qualquer organização". Redirect: /api/auth/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Apple (iCloud) — developer.apple.com → Services ID. Redirect: /api/auth/callback/apple
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=                     # JWT assinado com a chave .p8 (renovar a cada 6 meses)
APPLE_APP_BUNDLE_IDENTIFIER=

# Pagamentos (gateway padrão da empresa é configurado no banco; credenciais ficam aqui)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_SANDBOX=true

# Ambiente de testes: quadro "Entrar como", faixa de aviso e locadora de demonstração no build da Vercel
DEMO_MODE=false

# Vercel Blob (ambiente de testes). Preenchida pela Vercel ao conectar um Blob store privado.
BLOB_READ_WRITE_TOKEN=
# Ambiente de testes com Supabase (preenchidas pela integração da Vercel): bucket privado "foccus-car".
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Storage S3 compatível (S3, Cloudflare R2, MinIO)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Cifragem de dados bancários (AES-256-GCM)
DATA_ENCRYPTION_KEY=
STORAGE_REGION=
STORAGE_LOCAL_DIR=.storage
